{
  "name": "quill-react-commercial",
  "version": "1.6.3",
  "description": "A production-ready Quill 2 rich text editor for React: tables, image upload & resize, code highlighting with copy, markdown shortcuts, magic URL and i18n.",
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./lib/index.css": "./lib/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "readme.md",
    "readme_CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.less",
    "*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "build": "pnpm run clean && rollup -c && pnpm run build:types && pnpm run build:example",
    "build:types": "tsc -p tsconfig.build.json && node scripts/strip-asset-imports.mjs",
    "build:example": "babel example/app.js --out-dir ./example/compile && node scripts/copy-demo-assets.mjs",
    "clean": "rimraf lib dist",
    "example": "babel example/app.js --out-dir ./example/compile --source-maps && rimraf lib && rollup -c --watch",
    "babel": "babel example/app.js --watch --out-dir ./example/compile --source-maps",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,less,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,less,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build"
  },
  "author": "ludejun@live.cn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ludejun/quill-react-commercial.git"
  },
  "bugs": {
    "url": "https://github.com/ludejun/quill-react-commercial/issues"
  },
  "homepage": "https://ludejun.github.io/quill-react-commercial/",
  "license": "ISC",
  "dependencies": {
    "highlight.js": "^11.12.0",
    "normalize-url": "^8.0.2",
    "quill": "^2.0.3",
    "quill-delta": "^5.1.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.0",
    "@babel/core": "^8.0.0",
    "@babel/plugin-proposal-decorators": "^8.0.0",
    "@babel/preset-env": "^8.0.0",
    "@babel/preset-react": "^8.0.0",
    "@babel/preset-typescript": "^8.0.0",
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-strip": "^3.0.4",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "less": "^4.4.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.52.4",
    "rollup-plugin-css-only": "^4.5.2",
    "rollup-plugin-import-css": "^4.2.1",
    "rollup-plugin-less": "^1.1.3",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-svg": "^2.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "quill",
    "quill2",
    "quill-react",
    "react",
    "react-component",
    "rich-text-editor",
    "richtexteditor",
    "wysiwyg",
    "wysiwyg-editor",
    "editor",
    "text-editor",
    "markdown",
    "table",
    "image-upload",
    "code-highlight",
    "i18n",
    "typescript",
    "富文本编辑器",
    "辰记"
  ]
}
